{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-selectors.mjs\" --hook",
            "timeout": 30,
            "statusMessage": "Checking selectors"
          }
        ]
      }
    ]
  }
}
